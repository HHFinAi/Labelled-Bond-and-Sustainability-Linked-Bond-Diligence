      "prompt_path": "prompts/stages/mandate.md",
      "investment_gate": false
    },
    "evidence": {
      "id": "evidence",
      "title": "Evidence intake and reconciliation",
      "required_sections": [
        "source_register_review",
        "boundary_reconciliation",
        "material_gaps"
      ],
      "standard_ids": [],
      "requires_calculation": false,
      "prompt_path": "prompts/stages/evidence.md",
      "investment_gate": false
    },
    "terms": {
      "id": "terms",
      "title": "Instrument and creditor rights",
      "required_sections": [
        "obligor_guarantor",
        "rank_recourse_covenants",
        "coupon_call_maturity",
        "documentation_gaps"
      ],
      "standard_ids": [],
      "requires_calculation": false,
      "prompt_path": "prompts/stages/terms.md",
      "investment_gate": false
    },
