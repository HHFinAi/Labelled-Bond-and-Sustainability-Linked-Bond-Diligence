{
  "agent": "labelled-bond-slb-diligence-agent",
  "version": "0.2.0",
  "operations": [
    {
      "operation": "allocation_coverage",
      "signature": "(eligible_allocated: 'float', net_proceeds: 'float') -> 'float'",
      "argument_units": {
        "eligible_allocated": "$money",
        "net_proceeds": "$money"
      },
      "output_unit": "decimal_fraction",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "bond_price",
      "signature": "(face: 'float', annual_coupon: 'float', yield_to_maturity: 'float', years: 'float', frequency: 'int') -> 'float'",
      "argument_units": {
        "face": "$money",
        "annual_coupon": "decimal",
        "yield_to_maturity": "decimal",
        "years": "years",
        "frequency": "payments_per_year"
      },
      "output_unit": "$money",
      "description": "Coupon-date full price; accrued interest is zero at the assumed valuation date."
    },
    {
      "operation": "bond_risk",
      "signature": "(face: 'float', annual_coupon: 'float', yield_to_maturity: 'float', years: 'float', frequency: 'int') -> 'dict'",
      "argument_units": {
        "face": "$money",
        "annual_coupon": "decimal",
        "yield_to_maturity": "decimal",
        "years": "years",
        "frequency": "payments_per_year"
      },
      "output_unit": "bond_risk_metrics",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "dscr",
      "signature": "(cash_available: 'float', debt_service: 'float') -> 'float'",
      "argument_units": {
        "cash_available": "$money",
        "debt_service": "$money"
      },
      "output_unit": "multiple",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "greenium",
      "signature": "(labelled_spread_bps: 'float', matched_conventional_spread_bps: 'float') -> 'float'",
      "argument_units": {
        "labelled_spread_bps": "basis_points",
        "matched_conventional_spread_bps": "basis_points"
      },
      "output_unit": "basis_points",
      "description": "Positive value = labelled bond's tighter spread. Comparability is external."
    },
    {
      "operation": "holding_period_return",
      "signature": "(initial_dirty_price: 'float', exit_dirty_price: 'float', cash_income: 'float', funding_cost: 'float', transaction_cost: 'float') -> 'float'",
      "argument_units": {
        "initial_dirty_price": "$money",
        "exit_dirty_price": "$money",
        "cash_income": "$money",
        "funding_cost": "$money",
        "transaction_cost": "$money"
      },
      "output_unit": "decimal_return",
      "description": "See source code and domain methodology for assumptions."
    },
    {
      "operation": "npv",
      "signature": "(cashflows: 'list[float]', annual_discount: 'float') -> 'float'",
      "argument_units": {
        "cashflows": "$money",
        "annual_discount": "decimal"
      },
      "output_unit": "$money",
      "description": "Periodic NPV; cashflows[0] is at time zero, then annual periods."
    },
    {
      "operation": "scale",
      "signature": "(value: 'float', factor: 'float') -> 'float'",
      "argument_units": {
        "value": "$input_unit",
        "factor": "conversion_factor"
      },
      "output_unit": "$output_unit",
      "description": "Explicit arithmetic conversion; external unit semantics need human review."
    },
    {
      "operation": "slb_stepup_pv",
      "signature": "(face: 'float', step_up_bps: 'float', first_payment_period: 'int', last_payment_period: 'int', annual_discount: 'float', frequency: 'int') -> 'float'",
      "argument_units": {
        "face": "$money",
        "step_up_bps": "basis_points",
        "first_payment_period": "period_index",
        "last_payment_period": "period_index",
        "annual_discount": "decimal",
        "frequency": "payments_per_year"
      },
      "output_unit": "$money",
      "description": "PV of extra coupons IF the contractual step-up triggers; not expected value."
    }
  ]
}
